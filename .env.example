# CaseMap environment variables.
# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.
#
# The VITE_* pair is inlined into the browser bundle at build time (public by
# design, protected by RLS). The unprefixed pair is read server-side during SSR.
# Both pairs must point at the same project.

# --- Supabase: Project Settings > Data API ---
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PROJECT_ID="<project-ref>"
SUPABASE_PROJECT_ID="<project-ref>"

# --- Supabase: Project Settings > API Keys > publishable key (sb_publishable_...) ---
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- Supabase: Project Settings > API Keys > secret key (sb_secret_...) ---
# SERVER ONLY. Bypasses RLS. Never prefix this with VITE_ — that would ship it
# to the browser. Used by src/integrations/supabase/client.server.ts.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# --- AI: Anthropic (console.anthropic.com > API keys) ---
# NOT a Supabase value. Server-side only — never prefix with VITE_.
# Drives fact extraction, event building, summaries, questions, evidence
# mapping, consistency analysis, and document OCR, all via
# src/lib/ai-gateway.server.ts. Without it those features throw
# "ANTHROPIC_API_KEY missing"; questions and consistency degrade quietly to
# their non-AI paths instead of erroring.
ANTHROPIC_API_KEY=""

# --- AI: speech-to-text (optional) ---
# Voice notes only. The Anthropic Messages API has no transcription endpoint,
# so this call stays on an OpenAI-compatible /audio/transcriptions host — set
# it to OpenAI, Groq, or a self-hosted Whisper. Leave STT_API_KEY empty and
# voice notes fail with "Transcription is not configured"; nothing else breaks.
STT_API_KEY=""
STT_BASE_URL="https://api.openai.com/v1"
STT_MODEL="whisper-1"

# ---------------------------------------------------------------------------
# Transactional email (Sprint 5). Optional: with no RESEND_API_KEY the app
# records each message as "skipped" and sends nothing, which is a deployment
# without email rather than a stream of silent failures.
# ---------------------------------------------------------------------------
# Never prefix any of these with VITE_ — they are server-only.
RESEND_API_KEY=
# Envelope sender. Must be a domain verified with the provider.
EMAIL_FROM="CaseMap <notifications@example.com>"
# Absolute base URL used in email links.
APP_URL=https://your-deployment.vercel.app

# Shared secret for the reminder cron (/api/reminders). Without it the endpoint
# refuses every request, including Vercel's own scheduler — fail closed, because
# an open endpoint that sends mail is a way to mail people repeatedly.
# Vercel sets this header automatically for configured crons.
CRON_SECRET=
